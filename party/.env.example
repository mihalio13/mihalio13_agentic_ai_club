# Скопіюйте у .env:  cp .env.example .env
# Для локальної розробки достатньо DJANGO_DEBUG=1, решта має безпечні значення за замовчуванням.

# 1 — режим розробки (детальні помилки, без HTTPS). У продакшні ОБОВ'ЯЗКОВО 0.
DJANGO_DEBUG=1

# Обов'язковий у продакшні. Згенерувати:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Домени через кому (у продакшні). На Render підставляється автоматично.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Напр.: https://tusovka.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# За замовчуванням — SQLite у файлі db.sqlite3. Для продакшну — PostgreSQL:
# DATABASE_URL=postgres://user:password@host:5432/tusovka
DATABASE_URL=

# Скільки довірених reverse-proxy стоїть перед застосунком (Render/Nginx — 1, локально — 0).
TRUSTED_PROXY_COUNT=0

# Необов'язково: секретніший шлях до адмінки
DJANGO_ADMIN_URL=admin/

# Листи «Забули пароль?». Без EMAIL_HOST листи друкуються в консоль сервера.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
